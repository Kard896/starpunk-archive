---
const { tags = [] } = Astro.props as { tags?: string[] };
if (!tags.length) return null;
const norm = (s: string) => s.toLowerCase();
---

<ul class="flex flex-wrap gap-2 mt-6">
  {tags.map((t) => (
    <li>
      <a
        href={`/tags/${encodeURIComponent(norm(t))}/`}
        class="inline-block px-2 py-0.5 rounded-full border text-sm"
      >
        #{t}
      </a>
    </li>
  ))}
</ul>

