---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  const tagSet = new Set<string>();
  docs.forEach(d => (d.data.tags ?? []).forEach(t => tagSet.add(t)));

  return [...tagSet].map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;
const docs = (await getCollection("docs"))
  .filter(d => (d.data.tags ?? []).includes(tag!))
  .sort((a, b) => {
    const ad = a.data.date ? new Date(a.data.date).getTime() : 0;
    const bd = b.data.date ? new Date(b.data.date).getTime() : 0;
    return bd - ad;
  });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Tag: {tag}</title>
  </head>
  <body>
    <main class="max-w-3xl mx-auto p-6">
      <h1>Tag: {tag}</h1>

      {docs.length === 0 ? (
        <p>No entries yet for this tag.</p>
      ) : (
        <ul class="mt-6 space-y-3">
          {docs.map(d => (
            <li>
              <a href={`/${d.slug}/`} class="underline">{d.data.title}</a>
              {d.data.date && (
                <span> — {new Date(d.data.date).toLocaleDateString()}</span>
              )}
              {d.data.description && (
                <div class="text-sm opacity-80">{d.data.description}</div>
              )}
            </li>
          ))}
        </ul>
      )}

      <p class="mt-8"><a href="/tags/">← Back to all tags</a></p>
    </main>
  </body>
</html>
