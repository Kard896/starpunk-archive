---
import { getCollection } from "astro:content";

const docs = await getCollection("docs");

// Helper: normalize any frontmatter into a lowercase string[] of tags
function extractTags(data: Record<string, any>): string[] {
  // prefer "tags", then "tag", then "keywords"
  let raw =
    data?.tags ??
    data?.tag ??
    data?.keywords ??
    [];

  // allow single string, comma-separated string, or array
  if (typeof raw === "string") {
    // support "luna, deralo, Tech"
    raw = raw.split(",").map((s) => s.trim()).filter(Boolean);
  }

  if (Array.isArray(raw)) {
    return raw
      .map((t) => (typeof t === "string" ? t.trim() : ""))
      .filter(Boolean)
      .map((t) => t.toLowerCase());
  }

  return [];
}

// Build counts
const tagCounts = new Map<string, number>();
const docSummaries = docs.map((d) => {
  const tags = extractTags(d.data);
  tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1));
  return { slug: d.slug, title: d.data?.title ?? d.slug, tags };
});

const tags = [...tagCounts.entries()]
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => a.tag.localeCompare(b.tag));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Tags</title>
  </head>
  <body>
    <main class="max-w-3xl mx-auto p-6">
      <h1>Browse by Tag</h1>

      {tags.length === 0 ? (
        <p>No tags found.</p>
      ) : (
        <ul class="flex flex-wrap gap-3 mt-4">
          {tags.map(({ tag, count }) => (
            <li>
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="inline-block px-3 py-1 rounded-full border"
              >
                {tag} ({count})
              </a>
            </li>
          ))}
        </ul>
      )}

      <details class="mt-10">
        <summary class="cursor-pointer">Debug: documents & parsed tags</summary>
        <p class="mt-3 text-sm opacity-80">
          Found {docs.length} docs in the <code>docs</code> collection.
        </p>
        <ul class="mt-2 space-y-2 text-sm">
          {docSummaries.map((d) => (
            <li>
              <code>/{d.slug}/</code> — {d.title} — tags:{" "}
              {d.tags.length ? d.tags.join(", ") : "(none)"}
            </li>
          ))}
        </ul>
      </details>
    </main>
  </body>
</html>
